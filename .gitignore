# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# arquivos do sistema e de editores
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
.idea/
.vscode/*
!.vscode/extensions.json
*.swp

# segredos: chaves, certificados e credenciais (nunca commitar)
*.pem
*.key
*.p12
*.pfx
*.crt
*.keystore
id_rsa*
id_ed25519*
*credentials*.json
*service-account*.json
secrets.*
.npmrc

# configurações locais de assistentes de IA
.claude/settings.local.json

# supabase CLI (estado local)
supabase/.temp/
supabase/.branches/

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# anotações pessoais (ficam só no computador)
PROXIMOS-PASSOS.md
