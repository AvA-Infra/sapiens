# Copie para .env.local e preencha. NUNCA commite o .env.local.

# --- Público (pode ir ao navegador) ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Somente servidor (jamais expor ao cliente) ---
SUPABASE_SERVICE_ROLE_KEY=

# Rate limiting (Upstash Redis). Sem isso, usa memória local (só desenvolvimento).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Proteção anti-spam do formulário de contato (Cloudflare Turnstile)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Vídeo privado (Bunny Stream, por exemplo)
VIDEO_PROVIDER=bunny
BUNNY_STREAM_LIBRARY_ID=
BUNNY_STREAM_TOKEN_KEY=

# Pagamentos (stub; preencher quando o provedor for escolhido)
PAYMENT_PROVIDER=
PAYMENT_WEBHOOK_SECRET=
